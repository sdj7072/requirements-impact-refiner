{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements Impact Refiner controller analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "refined_requirement", "invariants", "impacts", "decision_needed", "decisions", "criteria", "unresolved", "scope", "workflow"],
  "properties": {
    "phase": {"enum": ["pre-decision", "post-decision"]},
    "refined_requirement": {"$ref": "#/$defs/text"},
    "invariants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invariant"}},
    "impacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/impact"}},
    "decision_needed": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/decisionNeeded"}]},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "scope": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope"}},
    "workflow": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 65536},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "keyList": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true},
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "behavior", "evidence_level", "evidence"],
      "properties": {"key": {"$ref": "#/$defs/key"}, "behavior": {"$ref": "#/$defs/text"}, "evidence_level": {"enum": ["verified", "inferred", "unknown"]}, "evidence": {"$ref": "#/$defs/text"}}
    },
    "impactSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["changed_feature", "possible_issue", "affected", "trigger", "prevention"],
      "properties": {"changed_feature": {"$ref": "#/$defs/text"}, "possible_issue": {"$ref": "#/$defs/text"}, "affected": {"$ref": "#/$defs/text"}, "trigger": {"$ref": "#/$defs/text"}, "prevention": {"$ref": "#/$defs/text"}}
    },
    "impact": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "category", "severity", "state", "evidence_level", "evidence", "invariant_keys", "decision_keys", "criterion_keys", "summary"],
      "properties": {"key": {"$ref": "#/$defs/key"}, "category": {"enum": ["functionality", "data", "interfaces", "authorization/privacy", "state/concurrency", "operations", "compatibility", "legal/policy", "regression"]}, "severity": {"enum": ["critical", "high", "medium", "low"]}, "state": {"enum": ["detected", "refining", "mitigated", "resolved", "accepted", "deferred", "blocked", "superseded"]}, "evidence_level": {"enum": ["verified", "inferred", "unknown"]}, "evidence": {"$ref": "#/$defs/text"}, "invariant_keys": {"$ref": "#/$defs/keyList"}, "decision_keys": {"$ref": "#/$defs/keyList"}, "criterion_keys": {"$ref": "#/$defs/keyList"}, "summary": {"$ref": "#/$defs/impactSummary"}}
    },
    "decisionOption": {
      "type": "object", "additionalProperties": false,
      "required": ["option", "impact_keys", "tradeoff"],
      "properties": {"option": {"$ref": "#/$defs/text"}, "impact_keys": {"$ref": "#/$defs/keyList"}, "tradeoff": {"$ref": "#/$defs/text"}}
    },
    "decisionNeeded": {
      "type": "object", "additionalProperties": false,
      "required": ["question", "options"],
      "properties": {"question": {"$ref": "#/$defs/text"}, "options": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/decisionOption"}}}
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "choice", "accepted_impact_keys", "rationale"],
      "properties": {"key": {"$ref": "#/$defs/key"}, "choice": {"$ref": "#/$defs/text"}, "accepted_impact_keys": {"$ref": "#/$defs/keyList"}, "rationale": {"$ref": "#/$defs/text"}}
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "impact_key", "invariant_key", "criterion", "evidence"],
      "properties": {"key": {"$ref": "#/$defs/key"}, "impact_key": {"$ref": "#/$defs/key"}, "invariant_key": {"$ref": "#/$defs/key"}, "criterion": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/text"}}
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["impact_key", "state", "rationale", "decision_key", "owner"],
      "properties": {"impact_key": {"$ref": "#/$defs/key"}, "state": {"enum": ["deferred", "blocked"]}, "rationale": {"$ref": "#/$defs/text"}, "decision_key": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/key"}]}, "owner": {"$ref": "#/$defs/text"}}
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary", "evidence", "confidence"],
      "properties": {"boundary": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/text"}, "confidence": {"$ref": "#/$defs/text"}}
    }
  }
}
