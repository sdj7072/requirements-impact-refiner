{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements Impact Refiner Graph Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "draft_id", "repo_root_sha256", "request_sha256", "settings", "providers", "nodes", "edges", "paths", "frontier", "timings_ms", "budget_status", "cache"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"$ref": "#/$defs/id32"},
    "draft_id": {"$ref": "#/$defs/id32"},
    "repo_root_sha256": {"$ref": "#/$defs/sha256"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "settings": {"$ref": "#/$defs/settings"},
    "providers": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/provider"}},
    "nodes": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/edge"}},
    "paths": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/path"}},
    "frontier": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/frontier"}},
    "timings_ms": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "integer", "minimum": 0}},
    "budget_status": {"enum": ["closed", "budget_exhausted", "provider_limited", "no_workspace"]},
    "cache": {"$ref": "#/$defs/cache"}
  },
  "$defs": {
    "id32": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"},
    "confidence": {"enum": ["verified-provider", "verified-source", "structural-inferred", "lexical"]},
    "domains": {"type": "array", "maxItems": 64, "items": {"enum": ["functionality", "data", "interfaces", "authorization/privacy", "state/concurrency", "operations", "compatibility", "legal/policy", "regression"]}},
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "max_seconds", "target_seconds", "providers", "install_policy", "deep"],
      "properties": {
        "enabled": {"type": "boolean"}, "max_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "target_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "providers": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "install_policy": {"const": "never"}, "deep": {"type": "boolean"}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "confidence", "version", "executable_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 4096},
        "status": {"enum": ["ready", "missing", "stale", "unsafe", "unsupported", "failed", "timed_out"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "version": {"type": ["string", "null"], "maxLength": 4096},
        "executable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "label", "location", "provider", "confidence", "source_sha256", "risk_domains"],
      "properties": {
        "id": {"type": "string", "pattern": "^NODE-[0-9]{3}$"},
        "kind": {"enum": ["symbol", "file", "api_field", "data_key", "schema", "database", "cache", "event", "permission", "configuration", "operation", "test"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 4096},
        "location": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
        "provider": {"type": "string", "minLength": 1, "maxLength": 4096}, "confidence": {"$ref": "#/$defs/confidence"},
        "source_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "risk_domains": {"$ref": "#/$defs/domains"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "target", "kind", "location", "evidence", "confidence", "provider", "source_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^EDGE-[0-9]{3}$"}, "source": {"type": "string", "pattern": "^NODE-[0-9]{3}$"}, "target": {"type": "string", "pattern": "^NODE-[0-9]{3}$"},
        "kind": {"enum": ["calls", "references", "implements", "imports", "reads", "writes", "serializes", "persists", "caches", "publishes", "subscribes", "authorizes", "configures", "deploys", "tests"]},
        "location": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]}, "evidence": {"type": "string", "minLength": 1, "maxLength": 4096},
        "confidence": {"$ref": "#/$defs/confidence"}, "provider": {"type": "string", "minLength": 1, "maxLength": 4096}, "source_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "path": {"type": "object", "additionalProperties": false, "required": ["id", "nodes", "edges", "distance", "risk_domains"], "properties": {"id": {"type": "string", "pattern": "^PATH-[0-9]{3}$"}, "nodes": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^NODE-[0-9]{3}$"}}, "edges": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "pattern": "^EDGE-[0-9]{3}$"}}, "distance": {"type": "integer", "minimum": 1}, "risk_domains": {"$ref": "#/$defs/domains"}}},
    "frontier": {"type": "object", "additionalProperties": false, "required": ["id", "node", "reason", "risk_domains"], "properties": {"id": {"type": "string", "pattern": "^FRONTIER-[0-9]{3}$"}, "node": {"type": "string", "pattern": "^NODE-[0-9]{3}$"}, "reason": {"type": "string", "minLength": 1, "maxLength": 4096}, "risk_domains": {"$ref": "#/$defs/domains"}}},
    "cache": {"type": "object", "additionalProperties": false, "required": ["status", "key", "invalidated_nodes"], "properties": {"status": {"enum": ["miss", "hit", "partial"]}, "key": {"$ref": "#/$defs/sha256"}, "invalidated_nodes": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^NODE-[0-9]{3}$"}}}}
  }
}
