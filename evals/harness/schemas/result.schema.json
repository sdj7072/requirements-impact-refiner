{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installed plugin evaluation result",
  "$ref": "#/$defs/runResult",
  "$defs": {
    "commandResult": {
      "type": "object",
      "required": ["argv", "returncode", "stdout", "stderr", "elapsed_seconds", "timed_out"],
      "additionalProperties": false,
      "properties": {
        "argv": { "type": "array", "items": { "type": "string" } },
        "returncode": { "type": ["integer", "null"] },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "timed_out": { "type": "boolean" }
      }
    },
    "clientProbe": {
      "type": "object",
      "required": ["client", "available", "version", "authenticated", "plugin_version", "enabled_plugins", "capabilities", "reason"],
      "additionalProperties": false,
      "properties": {
        "client": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "version": { "type": ["string", "null"] },
        "authenticated": { "type": ["boolean", "null"] },
        "plugin_version": { "type": ["string", "null"] },
        "enabled_plugins": { "type": "array", "items": { "type": "string" } },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": ["string", "null"] }
      }
    },
    "runResult": {
      "type": "object",
      "required": ["case_id", "repetition", "client", "status", "reason", "command", "final_output", "session_id", "metadata", "attempt", "retry_of"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "repetition": { "type": "integer", "minimum": 1 },
        "client": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["pass", "partial", "fail", "blocked", "infra_error", "invalid_evidence"]
        },
        "reason": { "type": ["string", "null"] },
        "command": { "anyOf": [{ "$ref": "#/$defs/commandResult" }, { "type": "null" }] },
        "final_output": { "type": ["string", "null"] },
        "session_id": { "type": ["string", "null"] },
        "attempt": { "type": "integer", "minimum": 1 },
        "retry_of": { "type": ["string", "null"] },
        "metadata": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string" }
          }
        }
      }
    },
    "mechanicalScore": {
      "type": "object",
      "required": ["case_id", "repetition", "passed", "findings"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "repetition": { "type": "integer", "minimum": 1 },
        "passed": { "type": "boolean" },
        "findings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "adjudication": {
      "type": "object",
      "required": ["case_id", "repetition", "rubric", "passed", "quote", "rationale"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "repetition": { "type": "integer", "minimum": 1 },
        "rubric": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "quote": { "type": "string" },
        "rationale": { "type": "string" }
      }
    },
    "performanceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "repetition", "status", "attempt", "retry_of", "prompt_bytes", "routed_resource_bytes", "routed_resource_words", "output_bytes", "output_words", "duration_ms", "input_tokens", "output_tokens", "impact_ids", "state_markdown_match", "workflow_boundary_passed", "controller_begin_calls", "controller_finalize_calls", "controller_draft_ids_match", "controller_finalize_succeeded", "controller_display_text_exact_match", "controller_display_text_presentation_equivalent", "controller_display_comparison"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "repetition": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["pass", "partial", "fail", "blocked", "infra_error", "invalid_evidence"] },
        "attempt": { "type": "integer", "minimum": 1 },
        "retry_of": { "type": ["string", "null"] },
        "prompt_bytes": { "type": "integer", "minimum": 0 },
        "routed_resource_bytes": { "type": "integer", "minimum": 0 },
        "routed_resource_words": { "type": "integer", "minimum": 0 },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "output_words": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "impact_ids": { "type": "array", "items": { "type": "string", "pattern": "^IMP-[0-9]{3}$" }, "uniqueItems": true },
        "state_markdown_match": { "type": "boolean" },
        "workflow_boundary_passed": { "type": "boolean" },
        "controller_begin_calls": { "type": "integer", "minimum": 0 },
        "controller_finalize_calls": { "type": "integer", "minimum": 0 },
        "controller_draft_ids_match": { "type": "boolean" },
        "controller_finalize_succeeded": { "type": "boolean" },
        "controller_display_text_exact_match": { "type": "boolean" },
        "controller_display_text_presentation_equivalent": { "type": "boolean" },
        "controller_display_comparison": { "const": "codex-markdown-v1" }
      }
    },
    "smokeGateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "errors", "median_output_words", "median_routed_resource_words"],
      "properties": {
        "passed": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "median_output_words": { "type": "number", "minimum": 0 },
        "median_routed_resource_words": { "type": "number", "minimum": 0 }
      }
    },
    "graphScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "repetition", "passed", "findings", "maximum_required_distance", "receipt_id", "receipt_sha256", "providers", "uncovered_high_risk_nodes", "matched_path_ids"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "repetition": { "type": "integer", "minimum": 1 },
        "passed": { "type": "boolean" },
        "findings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "maximum_required_distance": { "type": "integer", "minimum": 0 },
        "receipt_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
        "receipt_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "providers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "uncovered_high_risk_nodes": { "type": "array", "items": { "type": "string", "pattern": "^NODE-[0-9]{3}$" }, "uniqueItems": true },
        "matched_path_ids": { "type": "array", "items": { "type": "string", "pattern": "^PATH-[0-9]{3}$" }, "uniqueItems": true }
      }
    },
    "graphPerformanceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "repetition", "status", "mechanical_passed", "graph_passed", "attempt", "retry_of", "graph_duration_ms", "output_words", "routed_resource_words", "receipt_state_provider_parity", "uncovered_high_risk_nodes", "controller_begin_calls", "controller_trace_calls", "controller_finalize_calls", "controller_evidence_valid", "duplicate_or_error_calls", "input_tokens", "output_tokens"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "repetition": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["pass", "partial", "fail", "blocked", "infra_error", "invalid_evidence"] },
        "mechanical_passed": { "type": "boolean" },
        "graph_passed": { "type": "boolean" },
        "attempt": { "const": 1 },
        "retry_of": { "type": "null" },
        "graph_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "output_words": { "type": "integer", "minimum": 0 },
        "routed_resource_words": { "type": "integer", "minimum": 0 },
        "receipt_state_provider_parity": { "type": "boolean" },
        "uncovered_high_risk_nodes": { "type": "array", "items": { "type": "string", "pattern": "^NODE-[0-9]{3}$" }, "uniqueItems": true },
        "controller_begin_calls": { "type": "integer", "minimum": 0 },
        "controller_trace_calls": { "type": "integer", "minimum": 0 },
        "controller_finalize_calls": { "type": "integer", "minimum": 0 },
        "controller_evidence_valid": { "type": "boolean" },
        "duplicate_or_error_calls": { "type": "boolean" },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "graphSmokeGateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "errors", "median_graph_duration_ms", "median_output_words", "median_routed_resource_words"],
      "properties": {
        "passed": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "median_graph_duration_ms": { "type": "number", "minimum": 0 },
        "median_output_words": { "type": "number", "minimum": 0 },
        "median_routed_resource_words": { "type": "number", "minimum": 0 }
      }
    }
  }
}
